{
  "name": "congress-trades-dashboard",
  "version": "1.0.0",
  "description": "Local congressional stock trading dashboard with Golden Trade detection",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "setup": "node src/setup-db.js",
    "seed": "node src/seed-trades.js",
